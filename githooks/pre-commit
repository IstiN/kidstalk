#!/usr/bin/env bash
# Enable once after cloning: git config core.hooksPath githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --quiet -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' 'package.json' 'package-lock.json'; then
  echo "crap4js: testing and analyzing the source before commit…"
  npm run crap
fi
